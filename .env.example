# =============================================================================
# Carlos Caicedo Portfolio — Backend environment variables
# Copy this file to `.env` and fill in your values.
# NEVER commit `.env` to git.
# =============================================================================

# --- App ---
ENVIRONMENT=development
API_PREFIX=/api
CORS_ORIGINS=*

# --- Groq (AI assistant) ---
# Get a free API key at: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
USE_GROQ_AI=true

# --- Supabase (PostgreSQL + optional storage) ---
# Create a free project at: https://supabase.com/dashboard
# Project Settings → API → Project URL and service_role key
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Optional: direct Postgres connection (Settings → Database → Connection string)
DATABASE_URL=

# Use Supabase for knowledge graph (falls back to static data if empty/fails)
USE_SUPABASE_KNOWLEDGE=true
USE_SUPABASE_DATABASES=false
USE_SUPABASE_CONTENT=true

# --- Limits ---
MAX_NLP_INPUT_LENGTH=4000
MAX_AI_MESSAGE_LENGTH=4000
